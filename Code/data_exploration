def train_Kmeans_Mlflow(X, n_clusters=4, run_name="kmeans_run"):
    with mlflow.start_run(run_name=run_name):

        # 🔹 Scaling
        scaler = StandardScaler()
        X_scaled = scaler.fit_transform(X)

        # 🔹 Modèle
        model = KMeans(
            n_clusters=n_clusters,
            random_state=42,
            n_init=10
        )

        clusters = model.fit_predict(X_scaled)

        # 🔹 Métrique non supervisée
        sil_score = silhouette_score(X_scaled, clusters)

        # 🔹 Logging paramètres
        mlflow.log_param("model", "KMeans")
        mlflow.log_param("n_clusters", n_clusters)

        # 🔹 Logging métriques
        mlflow.log_metric("silhouette_score", sil_score)
        mlflow.log_metric("inertia", model.inertia_)

        # 🔹 Logging modèles
        mlflow.sklearn.log_model(model, "kmeans_model")
        mlflow.sklearn.log_model(scaler, "scaler")

        print("✅ Run MLflow enregistré")
        print("Silhouette score:", sil_score)

        return model, clusters, sil_score




